# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# translation/scraping data & logs (local only)
/data/*
/logs/

# Исключение — индекс скрапа partsfit. В нём копится firstSeen: когда позиция впервые
# появилась у донора. Повторным прогоном это не восстановить, а «последние поступления»
# на витрине считаются по нему. Карточки и таблицы наоборот выводятся из индекса
# и в гите не нужны: details/ 13 МБ и tables/ 23 МБ только по одним фарам.
#
# Через /data/* и цепочку исключений, а не /data/: каталог, исключённый целиком,
# git не обходит вовсе, и отрицания для файлов внутри него не срабатывают.
!/data/partsfit/
/data/partsfit/*
!/data/partsfit/index/

# То же для skywheel.kr, и по более острой причине: это доска объявлений, позиция
# живёт до продажи и исчезает без следа. index.json — единственное место, где остаётся
# firstSeen и lastSeen, то есть история наличия. items.json и wheels.json выводятся
# из него скрапом и классификатором.
!/data/skywheel/
/data/skywheel/*
!/data/skywheel/index.json

# Выгрузки Search Console — снимки на дату, а не исходники.
# src/data/raw_parts.json сюда НЕ добавлять: скрипта, который его создаёт, в репозитории
# нет, и без него catalog.json перестанет собираться заново.
/*.xlsx
