# react-simple-maps@3 объявляет peer-зависимость react ^16.8 || 17 || 18, а в проекте
# React 19. Пакет с React 19 работает (карта доставки на /ru/how-it-works), но npm без
# этого флага падает с ERESOLVE — на чистой машине и в CI установка не проходила вовсе,
# а флаг нигде не был зафиксирован: каждый ставил зависимости по-своему.
#
# Убрать этот файл можно будет, когда react-simple-maps обновит peer-диапазон либо когда
# карта переедет на поддерживаемую библиотеку. До тех пор он обязателен для деплоя.
legacy-peer-deps=true
