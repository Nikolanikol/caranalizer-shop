{
  "name": "caranalizer-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "docker:build": "docker build --build-arg NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:54321 --build-arg NEXT_PUBLIC_SUPABASE_ANON_KEY=$(grep -m1 '^NEXT_PUBLIC_SUPABASE_ANON_KEY=' .env.local | cut -d= -f2-) --build-arg NEXT_PUBLIC_SITE_URL=http://localhost:3900 -t caranalizer-local .",
    "docker:run": "docker run --rm -p 3900:3000 -e SUPABASE_SERVICE_ROLE_KEY=$(grep -m1 '^SUPABASE_SERVICE_ROLE_KEY=' .env.local | cut -d= -f2-) -e TELEGRAM_BOT_TOKEN=local -e TELEGRAM_CHAT_ID=0 -e TELEGRAM_WORK_CHAT_ID=0 caranalizer-local",
    "lint": "eslint",
    "partsfit:index": "node scripts/partsfit/scrape-index.mjs",
    "partsfit:coverage": "node scripts/partsfit/report-coverage.mjs",
    "partsfit:details": "node scripts/partsfit/scrape-details.mjs",
    "partsfit:tables": "node scripts/partsfit/build-tables.mjs",
    "partsfit:terms": "node --experimental-strip-types --no-warnings scripts/partsfit/report-terms.mjs",
    "partsfit:load": "node scripts/partsfit/load-supabase.mjs",
    "partsfit:viewer": "node scripts/partsfit/viewer/server.mjs",
    "partsfit:verify": "node scripts/partsfit/verify-db.mjs",
    "skywheel:scrape": "node scripts/skywheel/scrape.mjs",
    "skywheel:classify": "node scripts/skywheel/classify.mjs",
    "skywheel:tables": "node scripts/skywheel/build-tables.mjs",
    "skywheel:load": "node scripts/skywheel/load-supabase.mjs",
    "skywheel:verify": "node scripts/skywheel/verify-db.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:stop": "supabase stop",
    "start:prod": "next start -p 3900"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "next-intl": "^4.13.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-phone-number-input": "^3.4.17",
    "react-simple-maps": "^3.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
